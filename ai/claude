const sortedTasks = [...tasks].sort((a, b) => {
  if (sortBy === 'due_date') {
    // nulls last, since "no date" shouldn't jump to the top
    if (!a.due_date) return 1;
    if (!b.due_date) return -1;
    return new Date(a.due_date) - new Date(b.due_date);
